// Metric: articulation (legato / staccato)
// FR-006: ogni nota deve restare premuta almeno 30 ms.
//
// PERCHE' SI MISURA LA DURATA E NON IL SILENIO FRA DUE NOTE.
// La formulazione che suona piu' naturale e' "fra il rilascio di una nota e
// l'attacco della successiva non devono passare piu' di 30 ms". Non e'
// esprimibile su una traccia finita, e l'ho verificato: l'ultimo rilascio del
// brano non ha nessun attacco dopo di se', quindi la regola non puo' chiudersi
// e il monitor risponde "Unmatched end of trace" anche sulla esecuzione
// corretta. RML non ha modo di dire "a meno che la traccia non finisca qui".
//
// Misurando la durata il vincolo e' sempre soddisfacibile: ogni nota che parte
// ha un rilascio che la chiude. Il difetto resta rilevabile ed e' lo stesso
// difetto di prima, visto dal otro lato.
//
// TRUCCHETTO NECESSARIO PER DUE VOCI.
// filler accetta gli altri attacchi. Senza, con due voci che attaccano
// insieme il flusso e' attacco, attacco, rilascio, rilascio: il primo
// Articulation consumerebbe il primo attacco e troverebbe un attacco dove
// cerca un rilascio, e non chiuderebbe.
//
// LIMITE CONOSCIUTO, DICHIARATO.
// Cosi' l'Articulation parte dal primo attacco di ogni gruppo e assorbe gli
// altri. La seconda voce viene controllata solo se attacca da sola. Su questo
// brano le due voci attaccano e rilasciano sempre insieme, quindi meta' delle
// note non e' sottoposta a controllo diretto: se si schiaccia una nota della
// seconda voce, questa metrica non lo vede. Per chiuderlo servirebbe
// abbinare attacco e rilascio per altezza, e non c'e' modo di scrivere "nota
// diversa dalla precedente" dentro uno star. Il limite e' della regola, non
// della traccia: il JOIN emette tutto quello che serve.

controlEvent matches {type:'controlchange'};
noteOff matches {type:'noteoff'};

noteOnT(t2) matches {type:'noteon', timestamp:t2};

// tasto tenuto premuto almeno 30 ms
heldLong(t2) matches noteOffT(t1) with t1 - t2 >= 30;
noteOffT(t1) matches {type:'noteoff', timestamp:t1};

filler matches {type:'noteon'};
filler matches {type:'controlchange'};

Articulation = {let t2; noteOnT(t2) filler* heldLong(t2)};

Main = (controlEvent \/ noteOff \/ Articulation)*;